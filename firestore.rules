rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function active() { return userExists() && profile().aktif == true; }
    function role() { return active() ? profile().role : "none"; }
    function admin() { return role() == "Admin"; }
    function user() { return role() == "User"; }

    match /users/{uid} {
      allow read: if active() && (request.auth.uid == uid || admin());
      allow create, update, delete: if false;
    }
    match /reports/{reportId} {
      allow read: if active() && (admin() || (user()
        && resource.data.createdBy == request.auth.uid
        && resource.data.reporterMode == "teridentifikasi"));
      allow create, update, delete: if false;
    }
    match /cases/{caseId} {
      allow read: if admin();
      allow create, update, delete: if false;
    }
    match /documents/{docId} {
      allow read: if admin();
      allow create, update, delete: if false;
    }
    match /programs/{id} {
      allow read: if admin();
      allow create, update, delete: if false;
    }
    match /activities/{id} {
      allow read: if admin();
      allow create, update, delete: if false;
    }
    match /evaluations/{id} {
      allow read: if admin();
      allow create, update, delete: if false;
    }
    match /auditLogs/{id} {
      allow read: if admin();
      allow create, update, delete: if false;
    }
    match /counters/{id} { allow read, write: if false; }
    match /publicTracking/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
