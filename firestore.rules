rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().aktif == true; }
    function role() { return active() ? profile().role : "none"; }
    function admin() { return role() == "Admin"; }
    function committee() { return role() in ["Admin", "Ketua Komite", "Sekretaris", "Anggota Komite"]; }
    function assigned(caseData) { return signedIn() && request.auth.uid in caseData.assignedUids; }
    function caseReader(caseData) { return committee() || assigned(caseData) || (role() == "Auditor" && caseData.auditVisible == true); }
    function validText(v, max) { return v is string && v.size() <= max; }

    match /users/{uid} {
      allow read: if active() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }
    match /reports/{reportId} {
      allow read: if active() && (committee() || (resource.data.createdBy == request.auth.uid && resource.data.reporterMode == "teridentifikasi"));
      allow create, update, delete: if false; // Semua laporan dibuat melalui Cloud Functions.
    }
    match /cases/{caseId} {
      allow read: if active() && caseReader(resource.data);
      allow create, update, delete: if false; // Mutasi kasus wajib melalui Cloud Functions dan audit log.
    }
    match /documents/{docId} {
      allow read: if active() && (committee() || role() == "Auditor");
      allow create, update, delete: if false;
    }
    match /programs/{id} {
      allow read: if active();
      allow write: if admin() || role() == "Sekretaris";
    }
    match /activities/{id} {
      allow read: if active() && committee();
      allow write: if admin() || role() == "Sekretaris";
    }
    match /evaluations/{id} {
      allow read: if active() && committee();
      allow write: if admin() || role() == "Ketua Komite" || role() == "Sekretaris";
    }
    match /auditLogs/{id} {
      allow read: if active() && admin();
      allow write: if false;
    }
    match /counters/{id} { allow read, write: if false; }
    match /publicTracking/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}